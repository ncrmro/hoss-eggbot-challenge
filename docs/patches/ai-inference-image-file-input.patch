+import {describe, it, expect, beforeEach, afterEach} from 'vitest'
+import * as fs from 'fs'
+import * as path from 'path'
+import * as os from 'os'
+import {parseImageFiles, buildImageContentParts, attachImagesToRequest, flattenMessagesToText} from '../src/helpers.js'
+import {InferenceRequest} from '../src/inference.js'
+
+describe('parseImageFiles', () => {
+  it('returns empty array for empty input', () => {
+    expect(parseImageFiles('')).toEqual([])
+  })
+
+  it('splits on commas and newlines and trims whitespace', () => {
+    expect(parseImageFiles('a.png, b.jpg\n c.webp')).toEqual(['a.png', 'b.jpg', 'c.webp'])
+  })
+})
+
+describe('buildImageContentParts', () => {
+  let tmpDir: string
+
+  beforeEach(() => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'img-test-'))
+  })
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, {recursive: true, force: true})
+  })
+
+  it('encodes an image as a base64 data URI content part', () => {
+    const imgPath = path.join(tmpDir, 'egg.png')
+    fs.writeFileSync(imgPath, Buffer.from([0x89, 0x50, 0x4e, 0x47]))
+
+    const parts = buildImageContentParts([imgPath])
+    expect(parts).toHaveLength(1)
+    expect(parts[0].type).toBe('image_url')
+    if (parts[0].type === 'image_url') {
+      expect(parts[0].image_url.url).toBe(
+        `data:image/png;base64,${Buffer.from([0x89, 0x50, 0x4e, 0x47]).toString('base64')}`,
+      )
+    }
+  })
+
+  it('throws for missing files', () => {
+    expect(() => buildImageContentParts([path.join(tmpDir, 'nope.png')])).toThrow('Image file was not found')
+  })
+
+  it('throws for unsupported extensions', () => {
+    const badPath = path.join(tmpDir, 'egg.bmp')
+    fs.writeFileSync(badPath, 'x')
+    expect(() => buildImageContentParts([badPath])).toThrow('Unsupported image type')
+  })
+})
+
+describe('attachImagesToRequest', () => {
+  let tmpDir: string
+
+  beforeEach(() => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'img-test-'))
+  })
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, {recursive: true, force: true})
+  })
+
+  function makeRequest(): InferenceRequest {
+    return {
+      messages: [
+        {role: 'system', content: 'You are a judge'},
+        {role: 'user', content: 'Score this egg'},
+      ],
+      modelName: 'openai/gpt-4o',
+      endpoint: 'https://models.github.ai/inference',
+      token: 'test',
+    }
+  }
+
+  it('converts the last user message into multimodal content parts', () => {
+    const imgPath = path.join(tmpDir, 'egg.jpg')
+    fs.writeFileSync(imgPath, 'fake-jpeg-bytes')
+    const request = makeRequest()
+
+    attachImagesToRequest(request, [imgPath])
+
+    const userMessage = request.messages[1]
+    expect(Array.isArray(userMessage.content)).toBe(true)
+    const parts = userMessage.content as Exclude<InferenceRequest['messages'][0]['content'], string>
+    expect(parts[0]).toEqual({type: 'text', text: 'Score this egg'})
+    expect(parts[1].type).toBe('image_url')
+  })
+
+  it('leaves messages untouched for empty image list', () => {
+    const request = makeRequest()
+    attachImagesToRequest(request, [])
+    expect(request.messages[1].content).toBe('Score this egg')
+  })
+
+  it('throws when there is no user message', () => {
+    const imgPath = path.join(tmpDir, 'egg.jpg')
+    fs.writeFileSync(imgPath, 'fake')
+    const request = makeRequest()
+    request.messages = [{role: 'system', content: 'only system'}]
+    expect(() => attachImagesToRequest(request, [imgPath])).toThrow('no user message')
+  })
+})
+
+describe('flattenMessagesToText', () => {
+  it('passes through string content and flattens parts, dropping images', () => {
+    const messages: InferenceRequest['messages'] = [
+      {role: 'system', content: 'sys'},
+      {
+        role: 'user',
+        content: [
+          {type: 'text', text: 'Score this egg'},
+          {type: 'image_url', image_url: {url: 'data:image/png;base64,AAAA'}},
+        ],
+      },
+    ]
+    expect(flattenMessagesToText(messages)).toEqual([
+      {role: 'system', content: 'sys'},
+      {role: 'user', content: 'Score this egg'},
+    ])
+  })
+})
