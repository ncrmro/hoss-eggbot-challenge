  * Force-exit the process to avoid hanging on open connections.
@@ -169,6 +178,83 @@ function validateAndMaskHeaders(headers: Record<string, unknown>): Record<string
   return validHeaders
 }
 
+/**
+ * Parse the image-file input into a list of file paths.
+ * Accepts comma- or newline-separated paths.
+ */
+export function parseImageFiles(input: string): string[] {
+  if (!input) return []
+  return input
+    .split(/[\n,]/)
+    .map(s => s.trim())
+    .filter(s => s.length > 0)
+}
+
+/**
+ * Read image files and convert them to image_url content parts with
+ * base64 data URIs, as accepted by vision-capable chat completion models.
+ */
+export function buildImageContentParts(imagePaths: string[]): MessageContentPart[] {
+  return imagePaths.map(imagePath => {
+    if (!fs.existsSync(imagePath)) {
+      throw new Error(`Image file was not found: ${imagePath}`)
+    }
+    const ext = path.extname(imagePath).toLowerCase()
+    const mimeType = IMAGE_MIME_TYPES[ext]
+    if (!mimeType) {
+      throw new Error(
+        `Unsupported image type "${ext}" for ${imagePath} (supported: ${Object.keys(IMAGE_MIME_TYPES).join(', ')})`,
+      )
+    }
+    const base64 = fs.readFileSync(imagePath).toString('base64')
+    core.info(`Attaching image ${imagePath} (${mimeType}, ${base64.length} base64 chars)`)
+    return {
+      type: 'image_url',
+      image_url: {url: `data:${mimeType};base64,${base64}`},
+    }
+  })
+}
+
+/**
+ * Attach image content parts to the last user message of an inference request,
+ * converting its string content into a multimodal content-part array.
+ */
+export function attachImagesToRequest(request: InferenceRequest, imagePaths: string[]): void {
+  if (imagePaths.length === 0) return
+  const imageParts = buildImageContentParts(imagePaths)
+
+  const lastUserMessage = [...request.messages].reverse().find(msg => msg.role === 'user')
+  if (!lastUserMessage) {
+    throw new Error('Cannot attach images: no user message found in the prompt')
+  }
+
+  const existingParts: MessageContentPart[] =
+    typeof lastUserMessage.content === 'string'
+      ? [{type: 'text', text: lastUserMessage.content}]
+      : lastUserMessage.content
+
+  lastUserMessage.content = [...existingParts, ...imageParts]
+}
+
+/**
+ * Flatten multimodal message content back to plain text (dropping images),
+ * for providers that only accept string content (e.g. the Copilot CLI).
+ */
+export function flattenMessagesToText(
+  messages: InferenceRequest['messages'],
+): Array<{role: 'system' | 'user' | 'assistant' | 'tool'; content: string}> {
+  return messages.map(msg => ({
+    role: msg.role,
+    content:
+      typeof msg.content === 'string'
+        ? msg.content
+        : msg.content
+            .filter((part): part is {type: 'text'; text: string} => part.type === 'text')
+            .map(part => part.text)
+            .join('\n'),
+  }))
+}
+
 /**
  * Build complete InferenceRequest from prompt config and inputs
  */
